APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Base URL of the Nuxt storefront. The eSewa/Khalti callback routes redirect
# the browser here after server-side payment verification finishes.
FRONTEND_URL=http://127.0.0.1:3000

# --- eSewa payment gateway (v2 form API, https://developer.esewa.com.np) ---
# "test" uses eSewa's public UAT sandbox (no merchant account needed);
# "production" requires real merchant credentials issued by eSewa.
ESEWA_ENVIRONMENT=test
ESEWA_MERCHANT_ID=EPAYTEST
# eSewa publishes this exact secret for UAT testing. Replace with your real
# merchant secret in production — never reuse the UAT value live.
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
# Leave the URLs unset to use eSewa's standard test/production endpoints for
# the chosen ESEWA_ENVIRONMENT; only override if eSewa gives you different ones.
# ESEWA_GATEWAY_URL=
# ESEWA_STATUS_CHECK_URL=

# --- Khalti payment gateway (ePayment/KPG v2, https://docs.khalti.com) ---
KHALTI_ENVIRONMENT=test
KHALTI_PUBLIC_KEY=
# Server-side secret key from your Khalti merchant dashboard. Required for
# live payments — without it, Khalti checkout returns a clear "not
# configured" error rather than a fake success.
KHALTI_SECRET_KEY=
# KHALTI_BASE_URL=

# --- WhatsApp Cloud API (Meta), https://developers.facebook.com/docs/whatsapp ---
# All four values come from your Meta App / WhatsApp Business Platform setup.
# Leave blank to disable WhatsApp order-status notifications and the webhook
# signature check (the click-to-chat buttons on the storefront work
# independently of these — they only need the WhatsApp number set in the
# admin Footer Settings, not this Cloud API integration).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Shared secret you choose; enter the same value in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=
# App secret, used to verify incoming webhook signatures. Recommended once
# WHATSAPP_ACCESS_TOKEN is set.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
